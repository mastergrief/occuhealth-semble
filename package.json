{
  "name": "convex-medical-starter",
  "private": true,
  "version": "1.0.0",
  "description": "OccuFlow - GDPR-compliant occupational health platform",
  "type": "module",
  "scripts": {
    "dev": "npm-run-all --parallel dev:frontend dev:backend dev:typecheck",
    "dev:frontend": "vite --open",
    "dev:backend": "convex dev --typecheck=disable",
    "dev:typecheck": "tsgo --watch --noEmit --project tsconfig.app.json",
    "predev": "convex dev --until-success && convex dev --once --run-sh \"node setup.mjs --once\" && convex dashboard",
    "build": "npm-run-all build:typecheck build:app",
    "build:typecheck": "tsgo --noEmit --project tsconfig.app.json",
    "build:app": "vite build",
    "typecheck": "tsgo --noEmit --project tsconfig.app.json",
    "typecheck:tsc": "tsc --noEmit",
    "lint": "tsgo --noEmit --project tsconfig.app.json && eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "convex:deploy": "npm run typecheck && convex deploy --typecheck=disable",
    "convex:deploy:prod": "npm run typecheck && convex deploy --typecheck=disable --prod",
    "cap:sync": "npx cap sync",
    "cap:ios": "npx cap open ios",
    "cap:android": "npx cap open android",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:auth": "playwright test tests/e2e/auth/",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/core": "^7.4.3",
    "@capacitor/ios": "^7.4.3",
    "@capacitor/network": "^7.0.2",
    "@capacitor/preferences": "^7.0.2",
    "@convex-dev/auth": "^0.0.90",
    "@convex-dev/workos": "^0.0.1",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@workos-inc/authkit-react": "^0.15.0",
    "@workos-inc/node": "^7.79.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.31.2",
    "convex-helpers": "^0.1.108",
    "lucide-react": "^0.544.0",
    "openai": "^6.15.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.11.0",
    "sharp": "^0.34.5",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "terminal-image": "^4.1.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@capacitor/cli": "^7.4.3",
    "@eslint/js": "^9.21.0",
    "@playwright/test": "^1.57.0",
    "@tailwindcss/vite": "^4.0.14",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@typescript/native-preview": "^7.0.0-dev.20250827.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^4.0.16",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "convex-test": "^0.0.41",
    "dotenv": "^16.4.7",
    "eslint": "^9.21.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "glob": "^10.5.0",
    "globals": "^15.15.0",
    "jsdom": "^27.4.0",
    "npm-run-all": "^4.1.5",
    "playwright": "^1.57.0",
    "prettier": "^3.5.3",
    "tailwindcss": "^4.0.14",
    "tw-animate-css": "^1.3.8",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.24.1",
    "vite": "^6.2.0",
    "vitest": "^4.0.16"
  },
  "keywords": [
    "convex",
    "occuflow",
    "healthcare",
    "medical",
    "gdpr",
    "occupational-health",
    "react",
    "typescript",
    "capacitor",
    "mobile"
  ]
}
